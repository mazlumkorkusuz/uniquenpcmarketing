  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one Launch Flare action per view.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>Yayıncı Ekle</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 16px;border:0;border-radius:8px;background:linear-gradient(135deg, #7C3AED 0%, #C026D3 55%, #E11D48 100%);color:#fff;font:600 14px/1 'DM Sans',ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:box-shadow 240ms cubic-bezier(0.22,1,0.36,1),transform 150ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-primary svg{transition:transform 240ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-primary:hover{box-shadow:0 8px 24px -6px rgba(124,58,237,0.45);transform:translateY(-1px)}.ds-btn-primary:hover svg{transform:rotate(90deg)}.ds-btn-primary:active{transform:scale(0.97)}.ds-btn-primary:focus-visible{outline:2px solid #6D28D9;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined companion action; turns violet on hover.",
      "html": "<button class=\"ds-btn-secondary\">İptal</button>",
      "css": ".ds-btn-secondary{height:40px;padding:0 16px;border:1px solid #D8D2E6;border-radius:8px;background:#fff;color:#17122B;font:600 14px/1 'DM Sans',ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:border-color 150ms,color 150ms,transform 150ms}.ds-btn-secondary:hover{border-color:#6D28D9;color:#6D28D9}.ds-btn-secondary:active{transform:scale(0.97)}.ds-btn-secondary:focus-visible{outline:2px solid #6D28D9;outline-offset:2px}"
    },
    {
      "name": "Glass Card",
      "kind": "card",
      "refersTo": "card-glass",
      "description": "Every panel: quiet frosted glass that lifts and lights on hover.",
      "html": "<div class=\"ds-stage\"><article class=\"ds-card\"><div class=\"ds-card-label\">Toplam Yayıncı</div><div class=\"ds-card-metric\">1.284</div><div class=\"ds-card-meta\">Takip edilen kanal</div></article></div>",
      "css": ".ds-stage{padding:28px;background:radial-gradient(260px 200px at 10% 0%,rgba(124,58,237,0.22),transparent 70%),radial-gradient(240px 180px at 95% 100%,rgba(225,29,72,0.14),transparent 70%),#F6F5FB}.ds-card{max-width:260px;padding:20px;border-radius:20px;border:1px solid #E8E4F1;background:rgba(255,255,255,0.72);-webkit-backdrop-filter:blur(18px) saturate(140%);backdrop-filter:blur(18px) saturate(140%);box-shadow:inset 0 1px 0 rgba(255,255,255,0.9),inset 0 -1px 0 rgba(23,18,43,0.03),0 1px 2px rgba(23,18,43,0.04),0 1px 1px rgba(23,18,43,0.03);transition:transform 240ms cubic-bezier(0.22,1,0.36,1),box-shadow 240ms cubic-bezier(0.22,1,0.36,1),border-color 150ms;cursor:pointer}.ds-card:hover{transform:translateY(-2px);border-color:#D8D2E6;box-shadow:inset 0 1px 0 rgba(255,255,255,0.95),0 12px 32px -12px rgba(76,29,149,0.18),0 2px 6px rgba(23,18,43,0.05)}.ds-card-label{font:600 12px/1.4 'DM Sans',sans-serif;letter-spacing:0.08em;text-transform:uppercase;color:#655F7D}.ds-card-metric{margin-top:14px;font:600 32px/1 'Space Grotesk',sans-serif;letter-spacing:-0.03em;color:#17122B;font-variant-numeric:tabular-nums}.ds-card-meta{margin-top:8px;font:500 12.5px/1.4 'DM Sans',sans-serif;color:#655F7D}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "White field; the border turns violet with a soft ring on focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-label\">Kanal adı</span><input class=\"ds-input\" placeholder=\"Kanal veya kullanıcı adı ara...\"></label>",
      "css": ".ds-field{display:block;max-width:320px}.ds-label{display:block;margin-bottom:6px;font:600 13px/1.4 'DM Sans',sans-serif;color:#4A4462}.ds-input{width:100%;padding:10px 12px;border:1px solid #D8D2E6;border-radius:8px;background:#fff;color:#17122B;font:400 14px/1.5 'DM Sans',sans-serif;outline:none;transition:border-color 150ms,box-shadow 150ms}.ds-input::placeholder{color:#8C86A3}.ds-input:focus-visible{border-color:#6D28D9;box-shadow:0 0 0 4px rgba(109,40,217,0.12)}"
    },
    {
      "name": "Status Tag",
      "kind": "chip",
      "refersTo": "status-tag",
      "description": "Tint + matching ink with a 6px dot.",
      "html": "<span class=\"ds-tag ds-tag-ok\"><i></i>Aktif</span> <span class=\"ds-tag ds-tag-warn\"><i></i>Beklemede</span> <span class=\"ds-tag ds-tag-violet\"><i></i>Öncelikli</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:6px;padding:3px 8px;border-radius:8px;font:600 12px/1.4 'DM Sans',sans-serif}.ds-tag i{width:6px;height:6px;border-radius:50%;background:currentColor}.ds-tag-ok{background:#ECFDF5;color:#047857}.ds-tag-warn{background:#FFF7ED;color:#C2410C}.ds-tag-violet{background:#F3EEFF;color:#6D28D9}"
    },
    {
      "name": "Tabs",
      "kind": "chip",
      "refersTo": "tab-active",
      "description": "Segmented tabs; the active one is a violet tint.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab is-active\" role=\"tab\" aria-selected=\"true\">Global</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Japonya</button></div>",
      "css": ".ds-tabs{display:inline-flex;gap:4px;padding:4px;border:1px solid #E8E4F1;border-radius:12px;background:rgba(255,255,255,0.72)}.ds-tab{padding:8px 18px;border:0;border-radius:8px;background:transparent;color:#655F7D;font:600 13px/1 'DM Sans',sans-serif;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-tab:hover{color:#17122B}.ds-tab.is-active{background:#F3EEFF;color:#6D28D9}.ds-tab:focus-visible{outline:2px solid #6D28D9;outline-offset:2px}"
    },
    {
      "name": "Rank Row",
      "kind": "custom",
      "description": "Signature list row: rank (top 3 on the Launch Flare), name, magnitude bar, tabular value.",
      "html": "<ol class=\"ds-rank\"><li><span class=\"ds-rank-n is-top\">1</span><span class=\"ds-rank-body\"><b>Counter-Strike 2</b><span class=\"ds-bar\"><span style=\"width:100%\"></span></span></span><span class=\"ds-rank-v\">936K</span></li><li><span class=\"ds-rank-n\">4</span><span class=\"ds-rank-body\"><b>WARDOGS</b><span class=\"ds-bar\"><span style=\"width:19%\"></span></span></span><span class=\"ds-rank-v\">181K</span></li></ol>",
